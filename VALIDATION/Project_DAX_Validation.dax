-- DAX Measure Dictionary 
SELECT
      [Name],
      [Expression],
      [Description],
      [TableID]
FROM $SYSTEM. TMSCHEMA_MEASURES ORDER BY [Name]

-- all Tables
SELECT
    [ID],
    [Name],
    [Description],
    [IsHidden]
FROM $SYSTEM.TMSCHEMA_TABLES
ORDER BY [Name]

-- ALL Relationship
SELECT
    [ID],
    [FromTableID],
    [FromColumnID],
    [ToTableID],
    [ToColumnID],
    [IsActive]
FROM $SYSTEM.TMSCHEMA_RELATIONSHIPS
ORDER BY [ID]
      
 -- Vehicle Portfolio Validation
 EVALUATE
SUMMARIZECOLUMNS(
    'DimVehicle'[VehicleType],
    "Loans", [Total Loans],
    "Outstanding", [Total Outstanding],
    "Share", [Vehicle Portfolio Share],
    "Rank", [Vehicle Portfolio Rank]
)
ORDER BY [Outstanding] DESC


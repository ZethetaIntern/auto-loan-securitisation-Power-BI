EVALUATE
ROW(
    "Total Loans", DISTINCTCOUNT('auto_loan_securitisation_data'[LoanID]),
    "Total Outstanding", SUM('auto_loan_securitisation_data'[CurrentBalance]),
    "Original Balance", [Original Balance]
)

EVALUATE
ROW(
    "3M Avg 30Plus DPD Rate",
    [3M Avg 30Plus DPD Rate]
)

EVALUATE
ROW(
    "Total Loans", DISTINCTCOUNT('auto_loan_securitisation_data'[LoanID]),
    "Total Outstanding", SUM('auto_loan_securitisation_data'[CurrentBalance]),
    "3M Avg 30Plus DPD Rate", [3M Avg 30Plus DPD Rate],
    "ECL", [ECL]
)

EVALUATE
ROW(
    "Total EAD", [Total EAD],
    "12M PD", [12M PD],
    "LGD", [LGD],
    "ECL", [ECL]
)

